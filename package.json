{
  "name": "dsh-think-flow",
  "version": "0.1.0",
  "description": "Codex 风格过程播报：让 agent 在对话里按步骤说明正在做什么，颗粒度可在插件设置中调整。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    },
    "engines": {
      "dsh": ">=0.2.1-rc.1"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "narration",
    "progress",
    "codex"
  ],
  "license": "MIT"
}
